# Copia este archivo a .env y completa los valores reales.
# cp .env.example .env

# Cadena de conexión a PostgreSQL. Prisma requiere el formato nativo:
# postgresql://<usuario>:<password>@<host>:<puerto>/<base_de_datos>?schema=public
DATABASE_URL="postgresql://postgres:CAMBIAR_PASSWORD@localhost:5432/llaveros?schema=public"

# Secreto usado para firmar los JWT de sesión del panel admin.
# Genera uno fuerte, por ejemplo: openssl rand -base64 48
JWT_SECRET="CAMBIAR_POR_UN_SECRETO_ALEATORIO_Y_LARGO"

# URL pública del FRONTEND (no del backend). Se usa para construir los enlaces
# /nfc/{token} que se graban en los llaveros NFC al "Realizar venta".
APP_BASE_URL="http://localhost:4200"

# Puerto en el que escucha el backend NestJS.
PORT=3000
