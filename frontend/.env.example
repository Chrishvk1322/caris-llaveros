# Copia este archivo a .env y completa los valores reales.
# cp .env.example .env
#
# Angular no lee .env de forma nativa: al ejecutar `npm start` o `npm run build`
# el script scripts/generate-env.mjs (hook "pre") lee este archivo y genera
# src/environments/environment.ts automáticamente. No edites ese archivo a mano.

# URL pública del BACKEND (API de NestJS) que consumirá el frontend.
API_BASE_URL=http://localhost:3000

# "production": true genera el build optimizado para producción (afecta el
# valor de environment.production). Déjalo en false para desarrollo local.
NODE_ENV=development
