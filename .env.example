# Copia este archivo a .env en la VM (junto a docker-compose.yml) y completa los valores reales.
# cp .env.example .env

# Imagen publicada por el workflow de CI/CD en GitHub Container Registry.
# Formato: ghcr.io/<usuario-o-org-de-github>/caris-backend:latest (ghcr.io exige minúsculas)
BACKEND_IMAGE="ghcr.io/chrishvk1322/caris-backend:latest"

# Mismas variables que backend/.env.example — el contenedor las necesita en runtime.
DATABASE_URL="postgresql://caris_app:CAMBIAR_PASSWORD@postgres-compartido:5432/caris?schema=public"
JWT_SECRET="CAMBIAR_POR_UN_SECRETO_ALEATORIO_Y_LARGO"
APP_BASE_URL="https://CAMBIAR_POR_TU_DOMINIO"
PORT=3000
